message: "If you use or discuss this specification, please cite this software/specification release."
title: "Resolutive Science Mathematical Specification (RSMS)"
version: "1.0-rc.1"
date-released: 2026-08-07
type: software
authors:
  - family-names: "Matos"
    given-names: "Marcelo Roldão"
    orcid: "https://orcid.org/0009-0003-6075-4680"
repository-code: "https://github.com/marceloroldao/resolutive-science"
